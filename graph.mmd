flowchart TD
    classDef startNode fill:#e0e0e0,stroke:#333,stroke-width:2px;
    classDef endNode fill:#e0e0e0,stroke:#333,stroke-width:2px;
    
    classDef blueNode fill:#cce5ff,stroke:#0066cc,stroke-width:2px,rx:10px,ry:10px;
    classDef blueState fill:#ffffff,stroke:#0066cc,stroke-width:2px,rx:10px,ry:10px,text-align:left;
    
    classDef yellowNode fill:#fff2cc,stroke:#ffb300,stroke-width:2px,rx:10px,ry:10px;
    classDef yellowState fill:#ffffff,stroke:#ffb300,stroke-width:2px,rx:10px,ry:10px,text-align:left;
    
    classDef pinkNode fill:#f8cbad,stroke:#c00000,stroke-width:2px,rx:10px,ry:10px;
    classDef pinkState fill:#ffffff,stroke:#c00000,stroke-width:2px,rx:10px,ry:10px,text-align:left;
    
    classDef greenNode fill:#e2efda,stroke:#548235,stroke-width:2px,rx:10px,ry:10px;
    classDef greenState fill:#ffffff,stroke:#548235,stroke-width:2px,rx:10px,ry:10px,text-align:left;

    classDef purpleNode fill:#e6ccff,stroke:#9900ff,stroke-width:2px,rx:10px,ry:10px;
    classDef purpleState fill:#ffffff,stroke:#9900ff,stroke-width:2px,rx:10px,ry:10px,text-align:left;

    START([START]):::startNode

    subgraph Left [ ]
        direction TB
        web_search["web_search\n\nTavily search on the topic"]:::blueNode
        prompt_writer["prompt_writer\n\nWrite a DALL-E prompt\n(use critique on loops)"]:::yellowNode
        generator["generator\n\nCall DALL-E 3\nSave the PNG to outputs/"]:::pinkNode
        critic["critic\n\nVision LLM rates the image\nReturns rating + critique"]:::greenNode
        saver["saver\n\nSave final prompt & rating\nLog metadata"]:::purpleNode
    end

    subgraph Right [ ]
        direction TB
        state_web["State after web_search\n+ search_summary +bullet list"]:::blueState
        state_prompt["State after prompt_writer\n▶ current_prompt = new DALL-E prompt"]:::yellowState
        state_gen["State after generator\n▶ image_path = outputs/iter_N.png\n▶ iteration = iteration + 1"]:::pinkState
        state_critic["State after critic\n▶ rating = 1-10 (Pydantic)\n▶ critique = actionable feedback\n+ history += this iteration"]:::greenState
        state_saver["State after saver\n▶ Final outputs documented"]:::purpleState
    end
    
    END([END]):::endNode

    START --> web_search
    web_search --> prompt_writer
    prompt_writer --> generator
    generator --> critic
    
    critic -- "NO rating < target\n(loop with critique)" --> prompt_writer
    critic -- "YES rating >= target\n(or max loops)" --> saver
    
    saver --> END

    web_search -.- state_web
    prompt_writer -.- state_prompt
    generator -.- state_gen
    critic -.- state_critic
    saver -.- state_saver

    style Left fill:none,stroke:none
    style Right fill:none,stroke:none
    
    web_search ~~~ state_web
    prompt_writer ~~~ state_prompt
    generator ~~~ state_gen
    critic ~~~ state_critic
    saver ~~~ state_saver
